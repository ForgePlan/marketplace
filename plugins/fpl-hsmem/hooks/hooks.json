{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 12,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/recall.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/retain.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "timeout": 15,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/hooks/session-end.mjs"
            ]
          }
        ]
      }
    ]
  }
}
