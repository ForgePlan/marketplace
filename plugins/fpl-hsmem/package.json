{
  "name": "fpl-hsmem",
  "version": "3.7.2",
  "description": "ForgePlan memory client (project opt-in, multi-bank, Hindsight API >=0.10.2 and <0.11.0)",
  "type": "module",
  "main": "dist/index.mjs",
  "bin": {
    "fpl-hsmem": "dist/index.mjs",
    "fpl-hsmem-recall": "dist/hooks/recall.mjs",
    "fpl-hsmem-retain": "dist/hooks/retain.mjs",
    "fpl-hsmem-session-end": "dist/hooks/session-end.mjs",
    "fpl-hsmem-setup": "dist/setup.mjs",
    "fpl-hsmem-enrich": "dist/enrich.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run bundle",
    "bundle": "node build.mjs",
    "watch": "tsc --watch",
    "start": "node dist/index.mjs",
    "setup": "node dist/setup.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
